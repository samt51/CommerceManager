@model CommerceManager.Web.Models.BusinessOverviewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <div>
        <h1>Dashboard</h1>
        <p>Bugünün özeti. Perakende, Trendyol ve e-ticaret ayrı durur.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ApiError))
{
    <div class="alert-error">@Model.ApiError</div>
}

<div class="summary-grid">
    <div class="summary-card">
        <span>Bugünkü ciro</span>
        <strong>@TurkishMoney.Format(Model.TotalRevenue)</strong>
        <small>@Model.TotalSales satış</small>
    </div>
    <div class="summary-card">
        <span>Kasa</span>
        <strong>@TurkishMoney.Format(Model.CashBalance)</strong>
        <small>Bugünkü gider @TurkishMoney.Format(Model.TodayExpenses)</small>
    </div>
    <div class="summary-card">
        <span>Eldeki stok</span>
        <strong>@Model.OnHandQuantity</strong>
        <small>@Model.OutOfStockProducts ürün tükendi</small>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Kanallar</h2>
            <p>Trendyol tutarı sipariş servisinden anlık. E-ticaret site bağlanınca aynı şekilde gelecek.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Kanal</th>
                    <th>Satış</th>
                    <th>Ciro</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Perakende</strong></td>
                    <td>@Model.RetailSales</td>
                    <td>@TurkishMoney.Format(Model.RetailRevenue)</td>
                </tr>
                <tr>
                    <td><strong>Trendyol</strong></td>
                    <td>@Model.TrendyolOrders</td>
                    <td>@TurkishMoney.Format(Model.TrendyolRevenue)</td>
                </tr>
                <tr>
                    <td><strong>E-ticaret</strong></td>
                    <td>@Model.WebsiteOrders</td>
                    <td>@TurkishMoney.Format(Model.WebsiteRevenue)</td>
                </tr>
                <tr>
                    <td><strong>Toplam</strong></td>
                    <td><strong>@Model.TotalSales</strong></td>
                    <td><strong>@TurkishMoney.Format(Model.TotalRevenue)</strong></td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (Model.TrendyolFinanceAvailable)
    {
        <p class="panel-note">
            Bugün verilen Trendyol siparişlerinin finans kaydı:
            komisyon @TurkishMoney.Format(Model.TrendyolCommission),
            indirim @TurkishMoney.Format(Model.TrendyolDiscount),
            satıcı tutarı @TurkishMoney.Format(Model.TrendyolSellerRevenue).
            Üstteki ciro paket tutarıdır.
        </p>
    }
</div>
