@model CommerceManager.Web.Models.BusinessOverviewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <div>
        <h1>Dashboard</h1>
        <p>Ciro, kâr değildir. Alış fiyatı olmadığı için burada yalnızca satılan tutar görünür. Stok eldeki adettir.</p>
    </div>
</div>

<div class="channel-tabs">
    <a class="@(ViewBag.Period as string == "day" ? "is-on" : null)" href="/?period=day">Bugün</a>
    <a class="@(ViewBag.Period as string == "week" ? "is-on" : null)" href="/?period=week">Bu hafta</a>
    <a class="@(ViewBag.Period as string == "month" ? "is-on" : null)" href="/?period=month">Bu ay</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ApiError))
{
    <div class="alert-error">@Model.ApiError</div>
}

<div class="summary-grid">
    <div class="summary-card">
        <span>@(ViewBag.Period as string == "week" ? "Haftalık ciro" : ViewBag.Period as string == "month" ? "Aylık ciro" : "Bugünkü ciro")</span>
        <strong>@TurkishMoney.Format(Model.TotalRevenue)</strong>
        <small>@Model.TotalSales satış</small>
    </div>
    <div class="summary-card">
        <span>Kasa</span>
        <strong>@TurkishMoney.Format(Model.CashBalance)</strong>
        <small>Dönem gideri @TurkishMoney.Format(Model.TodayExpenses)</small>
    </div>
    <div class="summary-card">
        <span>Eldeki stok</span>
        <strong>@Model.OnHandQuantity</strong>
        <small>@Model.OutOfStockProducts ürün tükendi</small>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Kanallar</h2>
            <p>Trendyol ve e-ticaret tutarı sipariş servisinden anlık okunur.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Kanal</th>
                    <th>Satış</th>
                    <th>Ciro</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Perakende</strong></td>
                    <td>@Model.RetailSales</td>
                    <td>@TurkishMoney.Format(Model.RetailRevenue)</td>
                </tr>
                <tr>
                    <td><strong>Trendyol</strong></td>
                    <td>@Model.TrendyolOrders</td>
                    <td>@TurkishMoney.Format(Model.TrendyolRevenue)</td>
                </tr>
                <tr>
                    <td><strong>E-ticaret</strong></td>
                    <td>@Model.WebsiteOrders</td>
                    <td>@TurkishMoney.Format(Model.WebsiteRevenue)</td>
                </tr>
                <tr>
                    <td><strong>Toplam</strong></td>
                    <td><strong>@Model.TotalSales</strong></td>
                    <td><strong>@TurkishMoney.Format(Model.TotalRevenue)</strong></td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (Model.TrendyolFinanceAvailable && ViewBag.Period as string == "day")
    {
        <div class="finance-strip">
            <div>
                <span>Komisyon</span>
                <strong>@TurkishMoney.Format(Model.TrendyolCommission)</strong>
            </div>
            <div>
                <span>İndirim</span>
                <strong>@TurkishMoney.Format(Model.TrendyolDiscount)</strong>
            </div>
            <div>
                <span>Satıcı tutarı</span>
                <strong>@TurkishMoney.Format(Model.TrendyolSellerRevenue)</strong>
            </div>
            <p>Bugün verilen Trendyol siparişlerinin finans kaydı. Üstteki ciro paket tutarıdır.</p>
        </div>
    }
</div>
