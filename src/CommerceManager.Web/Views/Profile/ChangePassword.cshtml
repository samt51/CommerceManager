@model CommerceManager.Web.Models.Profile.ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="profile-page password-page">

    <div class="page-heading profile-heading">
        <div>
            <h1>Şifre Değiştir</h1>
            <p>Hesabınız için yeni ve güvenli bir şifre belirleyin.</p>
        </div>

        <a asp-controller="Profile"
           asp-action="Index"
           class="profile-secondary-button">
            ← Profilime Dön
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="profile-alert profile-alert-success">
            <span>✓</span>
            @success
        </div>
    }

    <div class="password-card">

        <div class="password-card-icon">⌁</div>

        <div class="profile-card-header">
            <h2>Güvenlik</h2>
            <p>
                Şifrenizi değiştirmek için önce mevcut şifrenizi doğrulayın.
            </p>
        </div>

        <form asp-controller="Profile"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="profile-validation"></div>

            <div class="profile-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword"
                       type="password"
                       class="profile-input"
                       autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>

            <div class="profile-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword"
                       type="password"
                       class="profile-input"
                       autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
                <small>En az 8 karakter kullanın.</small>
            </div>

            <div class="profile-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="profile-input"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="profile-actions">
                <button type="submit"
                        class="profile-primary-button">
                    Şifremi Değiştir
                </button>
            </div>

        </form>
    </div>
</div>
