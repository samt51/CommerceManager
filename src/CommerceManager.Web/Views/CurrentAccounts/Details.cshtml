@model CommerceManager.Web.Models.CurrentAccountDetails

@{
    ViewData["Title"] = Model.Name;
    var entry = ViewBag.Entry as CommerceManager.Web.Models.AddCurrentAccountEntryViewModel
        ?? new CommerceManager.Web.Models.AddCurrentAccountEntryViewModel { CurrentAccountId = Model.Id };
}

<div class="page-heading">
    <div>
        <h1>@Model.Name</h1>
        <p>@Model.KindText@(string.IsNullOrWhiteSpace(Model.Phone) ? "" : " · " + Model.Phone)</p>
    </div>
    <a asp-controller="CurrentAccounts" asp-action="Index" class="profile-secondary-button">← Carilere Dön</a>
</div>

<div class="summary-grid">
    <div class="summary-card">
        <span>Bakiye</span>
        <strong>@TurkishMoney.Format(Model.Balance)</strong>
        <small>@(Model.Balance > 0 ? "Cari borçlu" : Model.Balance < 0 ? "Cari alacaklı" : "Dengede")</small>
    </div>
    <div class="summary-card">
        <span>Telefon</span>
        <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</strong>
        <small>Vergi no @(string.IsNullOrWhiteSpace(Model.TaxNumber) ? "—" : Model.TaxNumber)</small>
    </div>
    <div class="summary-card">
        <span>Hareket</span>
        <strong>@Model.Entries.Count</strong>
        <small>Kayıtlı satır</small>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="profile-alert profile-alert-success"><span>✓</span> @success</div>
}

@if (TempData["EntryError"] is string error)
{
    <div class="alert-error">@error</div>
}

<div class="profile-form-card catalog-create-card">
    <div class="profile-card-header">
        <h2>Hareket ekle</h2>
        <p>Borç, cari size borçlanır. Alacak, tahsilat veya sizin borcunuzdur.</p>
    </div>

    <form asp-controller="CurrentAccounts" asp-action="AddEntry" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="@entry.CurrentAccountId" name="CurrentAccountId" />

        <div class="profile-field">
            <label>Hareket</label>
            <select name="Direction" class="profile-input">
                <option value="1">Borç</option>
                <option value="2">Alacak</option>
            </select>
        </div>

        <div class="profile-field">
            <label>Tutar</label>
            <input name="Amount" class="profile-input" type="number" min="0.01" step="0.01" />
        </div>

        <div class="profile-field">
            <label>Açıklama</label>
            <input name="Description" class="profile-input" />
        </div>

        <div class="profile-actions">
            <button type="submit" class="profile-primary-button">Hareketi Kaydet</button>
        </div>
    </form>
</div>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Hareketler</h2>
            <p>@(Model.Phone ?? "Telefon yok")</p>
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Hareket</th>
                    <th>Açıklama</th>
                    <th>Tutar</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr>
                    <td colspan="4" class="empty">Henüz hareket yok.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Entries)
                {
                    <tr>
                        <td>@item.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.DirectionText</td>
                        <td>@item.Description</td>
                        <td>@item.Amount.ToString("N2") ₺</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
