@using System.Security.Claims
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - TicaretPanel</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var fullName =
        User.FindFirst("full_name")?.Value
        ?? User.Identity?.Name
        ?? "Kullanıcı";

    var email =
        User.FindFirst(ClaimTypes.Email)?.Value
        ?? string.Empty;

    var role =
        User.FindFirst(ClaimTypes.Role)?.Value
        ?? string.Empty;

    var avatarLetter =
        string.IsNullOrWhiteSpace(fullName)
            ? "K"
            : fullName[..1].ToUpperInvariant();
}

<body>
<div class="app-shell">

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-mark">T</div>

            <div>
                <strong>TicaretPanel</strong>
                <span>E-Ticaret Yönetimi</span>
            </div>
        </div>

        <nav class="nav">

            <div class="nav-group">
                <a href="/">
                    <span class="nav-icon">⌂</span>
                    Dashboard
                </a>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Ürün ve stok</span>
                <a href="/Products"
                   class="@(currentController == "Products" && currentAction == "Index" ? "active" : null)">
                    <span class="nav-icon">▦</span>
                    Ürünler
                </a>
                <a href="/Catalog"
                   class="@(currentController == "Catalog" ? "active" : null)">
                    <span class="nav-icon">◇</span>
                    Genel Stok
                </a>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Satış</span>
                <a href="/Sales"
                   class="@(currentController == "Sales" ? "active" : null)">
                    <span class="nav-icon">＋</span>
                    Perakende
                </a>
                <a href="/Orders" class="@(currentController == "Orders" ? "active" : null)">
                    <span class="nav-icon">▣</span>
                    Siparişler
                </a>
                <a href="/Returns"
                   class="@(currentController == "Returns" ? "active" : null)">
                    <span class="nav-icon">↩</span>
                    İadeler
                </a>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Finans</span>
                <a href="/Cash"
                   class="@(currentController == "Cash" ? "active" : null)">
                    <span class="nav-icon">◎</span>
                    Kasa
                </a>
                <a href="/CurrentAccounts"
                   class="@(currentController == "CurrentAccounts" ? "active" : null)">
                    <span class="nav-icon">₺</span>
                    Cari
                </a>
                <a href="/Expenses"
                   class="@(currentController == "Expenses" ? "active" : null)">
                    <span class="nav-icon">−</span>
                    Giderler
                </a>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Sistem</span>
                <a href="/Products/Trendyol"
                   class="@(currentController == "Products" && currentAction is "Trendyol" or "Details" ? "active" : null)">
                    <span class="nav-icon">▦</span>
                    Entegrasyon Ürünleri
                </a>
                <a href="/Reports"
                   class="@(currentController == "Reports" ? "active" : null)">
                    <span class="nav-icon">▥</span>
                    Raporlar
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Users"
                       asp-action="Index"
                       class="@(currentController == "Users" ? "active" : null)">
                        <span class="nav-icon">♙</span>
                        Kullanıcılar
                    </a>
                }
                <a href="/Settings"
                   class="@(currentController == "Settings" ? "active" : null)">
                    <span class="nav-icon">⚙</span>
                    Ayarlar
                </a>
            </div>

        </nav>

        <div class="sidebar-user">
            <button type="button"
                    class="sidebar-footer sidebar-user-button"
                    id="sidebarUserButton"
                    aria-expanded="false">

                <div class="avatar">@avatarLetter</div>

                <div class="sidebar-user-info">
                    <strong>@fullName</strong>
                    <span>@email</span>
                </div>

                <span class="sidebar-user-chevron">⌃</span>
            </button>

            <div class="sidebar-user-menu"
                 id="sidebarUserMenu">

                <div class="sidebar-user-menu-header">
                    <strong>@fullName</strong>
                    <span>@role</span>
                </div>

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="sidebar-user-menu-item">
                    <span>○</span>
                    Profilim
                </a>

                <a asp-controller="Profile"
                   asp-action="ChangePassword"
                   class="sidebar-user-menu-item">
                    <span>⌁</span>
                    Şifre Değiştir
                </a>

                <div class="sidebar-user-menu-separator"></div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="sidebar-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="sidebar-user-menu-item sidebar-logout-button">
                        <span>↪</span>
                        Çıkış Yap
                    </button>
                </form>
            </div>
        </div>

    </aside>

    <div class="sidebar-overlay"
         id="sidebarOverlay"></div>

    <main class="main">

        <header class="topbar">
            <div class="topbar-left">
                <button type="button"
                        class="mobile-menu-button"
                        id="mobileMenuButton"
                        aria-label="Menüyü aç"
                        aria-expanded="false">
                    ☰
                </button>

                <div>
                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="topbar-subtitle">
                    E-Ticaret Yönetim Paneli
                </div>
            </div>
            </div>

            <div class="top-actions">
                <button type="button"
                        class="icon-button">⌕</button>

                <button type="button"
                        class="icon-button">♢</button>
            </div>
        </header>

        <section class="content">
            @RenderBody()
        </section>

    </main>

</div>

<script>
    (() => {
        const button = document.getElementById('mobileMenuButton');
        const sidebar = document.querySelector('.sidebar');
        const overlay = document.getElementById('sidebarOverlay');

        if (!button || !sidebar || !overlay) {
            return;
        }

        const closeMenu = () => {
            sidebar.classList.remove('mobile-open');
            overlay.classList.remove('active');
            document.body.classList.remove('menu-open');
            button.setAttribute('aria-expanded', 'false');
        };

        button.addEventListener('click', () => {
            const isOpen = sidebar.classList.toggle('mobile-open');

            overlay.classList.toggle('active', isOpen);
            document.body.classList.toggle('menu-open', isOpen);
            button.setAttribute('aria-expanded', String(isOpen));
        });

        overlay.addEventListener('click', closeMenu);

        sidebar.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu);
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 1024) {
                closeMenu();
            }
        });

        const userButton = document.getElementById('sidebarUserButton');
        const userMenu = document.getElementById('sidebarUserMenu');

        userButton?.addEventListener('click', (event) => {
            event.stopPropagation();

            const isOpen = userMenu?.classList.toggle('open') ?? false;
            userButton.setAttribute('aria-expanded', String(isOpen));
        });

        userMenu?.addEventListener('click', (event) => {
            event.stopPropagation();
        });

        document.addEventListener('click', () => {
            userMenu?.classList.remove('open');
            userButton?.setAttribute('aria-expanded', 'false');
        });
    })();
</script>
</body>
</html>
