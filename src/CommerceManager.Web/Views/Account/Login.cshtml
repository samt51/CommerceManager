@model CommerceManager.Web.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap | Commerce Manager</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        body {
            min-height: 100vh;
            color: #17211d;
            background: #f5f8f7;
        }

        .login-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(400px, .95fr) minmax(520px, 1.05fr);
        }

        .brand-panel {
            position: relative;
            overflow: hidden;
            padding: 54px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: white;
            background: linear-gradient(145deg, #08764f, #0f8f62 48%, #075d41);
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            width: 460px;
            height: 460px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.12);
            right: -190px;
            top: -160px;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -130px;
            bottom: -100px;
        }

        .brand-logo,
        .brand-main,
        .brand-footer {
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 20px;
            font-weight: 750;
        }

        .logo-icon {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.16);
        }

        .logo-icon svg {
            width: 23px;
        }

        .brand-main {
            max-width: 520px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 8px 13px;
            margin-bottom: 22px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.08);
            font-size: 12px;
            font-weight: 650;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #9af1c8;
            box-shadow: 0 0 0 5px rgba(154,241,200,.10);
        }

        .brand-main h1 {
            margin: 0 0 18px;
            font-size: clamp(38px, 4vw, 59px);
            line-height: 1.03;
            letter-spacing: -2.4px;
        }

        .brand-main p {
            margin: 0;
            max-width: 460px;
            color: rgba(255,255,255,.75);
            font-size: 15px;
            line-height: 1.7;
        }

        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 30px;
        }

        .feature {
            padding: 9px 13px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(255,255,255,.08);
            font-size: 12px;
            font-weight: 600;
        }

        .brand-footer {
            color: rgba(255,255,255,.55);
            font-size: 12px;
        }

        .form-panel {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 48px;
            background:
                radial-gradient(circle at 90% 10%, rgba(15,143,98,.08), transparent 25%),
                #f7f9f8;
        }

        .login-box {
            width: 100%;
            max-width: 430px;
        }

        .mobile-logo {
            display: none;
        }

        .heading {
            margin-bottom: 31px;
        }

        .heading h2 {
            margin: 0 0 9px;
            color: #15221c;
            font-size: 31px;
            letter-spacing: -1px;
        }

        .heading p {
            margin: 0;
            color: #75817b;
            font-size: 14px;
            line-height: 1.6;
        }

        .validation-summary {
            margin-bottom: 18px;
            padding: 12px 14px;
            border: 1px solid #f1caca;
            border-radius: 11px;
            background: #fff4f4;
            color: #a63d3d;
            font-size: 13px;
        }

        .validation-summary.validation-summary-valid {
            display: none;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field > label {
            display: block;
            margin-bottom: 8px;
            color: #35423c;
            font-size: 13px;
            font-weight: 650;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 15px;
            width: 18px;
            transform: translateY(-50%);
            color: #8b9791;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            height: 51px;
            padding: 0 46px;
            border: 1px solid #dce4e0;
            border-radius: 12px;
            outline: none;
            background: white;
            color: #1b2722;
            font: inherit;
            font-size: 14px;
            transition: .18s ease;
        }

        .form-control::placeholder {
            color: #a6b0ab;
        }

        .form-control:focus {
            border-color: #0f8f62;
            box-shadow: 0 0 0 4px rgba(15,143,98,.09);
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 10px;
            width: 34px;
            height: 34px;
            transform: translateY(-50%);
            display: grid;
            place-items: center;
            padding: 0;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #7d8983;
            cursor: pointer;
        }

        .password-toggle:hover {
            color: #0f8f62;
            background: #f0f5f3;
        }

        .password-toggle svg {
            width: 18px;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: #b64343;
            font-size: 12px;
        }

        .options {
            margin: 4px 0 24px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #59665f;
            font-size: 13px;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
        }

        .remember input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .remember-box {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
            display: grid;
            place-items: center;
            border: 1.5px solid #aeb9b4;
            border-radius: 5px;
            background: #fff;
            color: #fff;
            transition: .15s ease;
        }

        .remember-box svg {
            width: 13px;
            height: 13px;
            opacity: 0;
            transform: scale(.7);
            transition: .15s ease;
        }

        .remember input:checked + .remember-box {
            border-color: #0f8f62;
            background: #0f8f62;
            box-shadow: 0 0 0 3px rgba(15,143,98,.09);
        }

        .remember input:checked + .remember-box svg {
            opacity: 1;
            transform: scale(1);
        }

        .remember input:focus-visible + .remember-box {
            outline: 3px solid rgba(15,143,98,.16);
            outline-offset: 2px;
        }

        .remember-text {
            line-height: 19px;
        }

        .remember:hover .remember-box {
            border-color: #0f8f62;
        }

        .remember-native {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #59665f;
            font-size: 13px;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
        }

        .remember-native input[type="checkbox"] {
            width: 18px;
            height: 18px;
            margin: 0;
            cursor: pointer;
            accent-color: #0f8f62;
        }

        .remember-native span {
            cursor: pointer;
        }


        /* Remember me */
        .remember-clean {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
            color: #59665f;
            font-size: 13px;
        }

        .remember-clean input[type="checkbox"] {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            margin: 0 !important;
            padding: 0 !important;
            opacity: 0 !important;
            pointer-events: none;
        }

        .remember-check {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
            display: grid;
            place-items: center;
            border: 1.5px solid #aeb9b4;
            border-radius: 5px;
            background: #fff;
            transition: all .15s ease;
        }

        .remember-check svg {
            width: 13px;
            height: 13px;
            color: #fff;
            opacity: 0;
            transform: scale(.65);
            transition: all .15s ease;
        }

        .remember-clean:hover .remember-check {
            border-color: #0f8f62;
        }

        .remember-clean input[type="checkbox"]:checked + .remember-check {
            background: #0f8f62;
            border-color: #0f8f62;
            box-shadow: 0 0 0 3px rgba(15,143,98,.10);
        }

        .remember-clean input[type="checkbox"]:checked + .remember-check svg {
            opacity: 1;
            transform: scale(1);
        }

        .remember-clean input[type="checkbox"]:focus-visible + .remember-check {
            outline: 3px solid rgba(15,143,98,.16);
            outline-offset: 2px;
        }

        .login-button {
            width: 100%;
            height: 51px;
            border: 0;
            border-radius: 12px;
            background: #0f8f62;
            color: white;
            font: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 10px 24px rgba(15,143,98,.19);
            transition: .15s ease;
        }

        .login-button:hover {
            transform: translateY(-1px);
            background: #0c7f57;
            box-shadow: 0 13px 28px rgba(15,143,98,.24);
        }

        .secure-note {
            margin-top: 29px;
            padding-top: 22px;
            border-top: 1px solid #e4ebe7;
            text-align: center;
            color: #929c97;
            font-size: 12px;
        }

        @@media (max-width: 900px) {
            .login-page {
                display: block;
            }

            .brand-panel {
                display: none;
            }

            .form-panel {
                padding: 36px 24px;
            }

            .mobile-logo {
                display: flex;
                align-items: center;
                gap: 11px;
                margin-bottom: 48px;
                color: #0f8f62;
                font-size: 18px;
                font-weight: 750;
            }

            .mobile-logo .logo-icon {
                width: 40px;
                height: 40px;
                background: #e6f4ef;
                border: 0;
            }
        }

        @@media (max-width: 440px) {
            .form-panel {
                align-items: flex-start;
                padding: 27px 20px;
            }

            .mobile-logo {
                margin-bottom: 48px;
            }

            .heading {
                margin-bottom: 27px;
            }

            .heading h2 {
                font-size: 27px;
            }

            .heading p {
                font-size: 13px;
            }

            .form-control {
                height: 50px;
                font-size: 16px;
            }

            .login-button {
                height: 50px;
            }
        }
    </style>
</head>

<body>
<main class="login-page">

    <section class="brand-panel">
        <div class="brand-logo">
            <span class="logo-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19V9l8-5 8 5v10" />
                    <path d="M8 19v-6h8v6" />
                    <path d="M3 19h18" />
                </svg>
            </span>
            Commerce Manager
        </div>

        <div class="brand-main">
            <div class="badge">
                <span class="badge-dot"></span>
                Yönetim Paneli
            </div>

            <h1>Tüm satış operasyonunuz tek ekranda.</h1>

            <p>
                Siparişleri, ürünleri, stokları ve iadeleri merkezi bir yapı
                üzerinden güvenli ve hızlı şekilde yönetin.
            </p>

            <div class="features">
                <span class="feature">Sipariş Yönetimi</span>
                <span class="feature">Stok Takibi</span>
                <span class="feature">İade Yönetimi</span>
            </div>
        </div>

        <div class="brand-footer">
            © @DateTime.Now.Year Commerce Manager
        </div>
    </section>

    <section class="form-panel">
        <div class="login-box">

            <div class="mobile-logo">
                <span class="logo-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19V9l8-5 8 5v10" />
                        <path d="M8 19v-6h8v6" />
                        <path d="M3 19h18" />
                    </svg>
                </span>
                Commerce Manager
            </div>

            <div class="heading">
                <h2>Tekrar hoş geldiniz</h2>
                <p>Yönetim paneline devam etmek için hesabınıza giriş yapın.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@returnUrl"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="field">
                    <label asp-for="UserName"></label>

                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21a8 8 0 0 0-16 0" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>

                        <input asp-for="UserName"
                               class="form-control"
                               autocomplete="username"
                               placeholder="Kullanıcı adınızı girin"
                               autofocus />
                    </div>

                    <span asp-validation-for="UserName"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>

                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="10" width="16" height="10" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>

                        <input asp-for="Password"
                               type="password"
                               id="loginPassword"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Şifrenizi girin" />

                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                aria-label="Şifreyi göster">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.5" />
                            </svg>
                        </button>
                    </div>

                    <span asp-validation-for="Password"></span>
                </div>

                <div class="options">
                    <label class="remember-clean">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span class="remember-check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor"
                                 stroke-width="3"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12l4 4L19 7" />
                            </svg>
                        </span>
                        <span>Beni hatırla</span>
                    </label>
                </div>

                <button type="submit" class="login-button">
                    Giriş Yap
                </button>
            </form>

            <div class="secure-note">
                Güvenli yönetim paneli erişimi
            </div>
        </div>
    </section>

</main>

<script>
    (() => {
        const input = document.getElementById("loginPassword");
        const button = document.getElementById("passwordToggle");

        button?.addEventListener("click", () => {
            const show = input.type === "password";
            input.type = show ? "text" : "password";
            button.setAttribute(
                "aria-label",
                show ? "Şifreyi gizle" : "Şifreyi göster"
            );
        });

    })();
</script>
</body>
</html>

<style>
    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none !important;
    }
</style>
